{
  "uid": "siem-ops",
  "title": "SIEM - Operations",
  "tags": [
    "siem"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": {
    "from": "now-3h",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Events accepted / s (by source)",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (source_type) (rate(siem_events_accepted_total[5m]))",
          "legendFormat": "{{source_type}}"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Rejected & parse failures / s",
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (reason) (rate(siem_events_rejected_total[5m]))",
          "legendFormat": "rejected {{reason}}"
        },
        {
          "refId": "B",
          "expr": "sum by (source_type) (rate(siem_parse_failures_total[5m]))",
          "legendFormat": "parse {{source_type}}"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Alerts created / min (by rule)",
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (rule) (increase(siem_alerts_created_total[5m]))/5",
          "legendFormat": "{{rule}}"
        }
      ]
    },
    {
      "id": 4,
      "type": "bargauge",
      "title": "Alerts by severity (1h)",
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (severity) (increase(siem_alerts_created_total[1h]))",
          "legendFormat": "{{severity}}"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Suppressed (merged) findings / min",
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (rule) (increase(siem_alerts_suppressed_total[5m]))/5",
          "legendFormat": "{{rule}}"
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Detection & background failures",
      "gridPos": {
        "x": 12,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (rule) (increase(siem_detection_failures_total[15m]))",
          "legendFormat": "detection {{rule}}"
        },
        {
          "refId": "B",
          "expr": "sum by (task) (increase(siem_background_failures_total[15m]))",
          "legendFormat": "task {{task}}"
        }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "API request rate by status",
      "gridPos": {
        "x": 0,
        "y": 24,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (status) (rate(siem_http_requests_total[5m]))",
          "legendFormat": "{{status}}"
        }
      ]
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "API latency p95 by route",
      "gridPos": {
        "x": 12,
        "y": 24,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le, route) (rate(siem_http_request_seconds_bucket[5m])))",
          "legendFormat": "{{route}}"
        }
      ]
    },
    {
      "id": 9,
      "type": "stat",
      "title": "Database up",
      "gridPos": {
        "x": 0,
        "y": 32,
        "w": 6,
        "h": 5
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "siem_database_up",
          "legendFormat": "postgres"
        }
      ]
    },
    {
      "id": 10,
      "type": "stat",
      "title": "OpenSearch up",
      "gridPos": {
        "x": 6,
        "y": 32,
        "w": 6,
        "h": 5
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "siem_opensearch_up",
          "legendFormat": "opensearch"
        }
      ]
    },
    {
      "id": 11,
      "type": "stat",
      "title": "Seconds since last collector delivery",
      "gridPos": {
        "x": 12,
        "y": 32,
        "w": 6,
        "h": 5
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "siem_collector_last_seen_age_seconds",
          "legendFormat": "age"
        }
      ]
    },
    {
      "id": 12,
      "type": "stat",
      "title": "Notifications (sent/failed per hour)",
      "gridPos": {
        "x": 18,
        "y": 32,
        "w": 6,
        "h": 5
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (channel,status) (increase(siem_notifications_total[1h]))",
          "legendFormat": "{{channel}} {{status}}"
        }
      ]
    },
    {
      "id": 13,
      "type": "timeseries",
      "title": "Fluent Bit output records / dropped",
      "gridPos": {
        "x": 0,
        "y": 37,
        "w": 24,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (name) (rate(fluentbit_output_proc_records_total[5m]))",
          "legendFormat": "sent {{name}}"
        },
        {
          "refId": "B",
          "expr": "sum by (name) (rate(fluentbit_output_dropped_records_total[5m]))",
          "legendFormat": "dropped {{name}}"
        }
      ]
    }
  ]
}