# Copy to .env (or run scripts\siem.ps1 setup, which generates strong secrets for you).
# NEVER commit .env. Every value below marked CHANGE_ME must be replaced.

# --- core secrets ---------------------------------------------------------
POSTGRES_PASSWORD=CHANGE_ME
SIEM_JWT_SECRET=CHANGE_ME_AT_LEAST_32_RANDOM_CHARS
GRAFANA_ADMIN_PASSWORD=CHANGE_ME
# Comma-separated ingestion keys accepted by /api/ingest. SIEM_COLLECTOR_KEY is the key Fluent Bit uses (must be listed).
SIEM_INGEST_API_KEYS=CHANGE_ME_COLLECTOR_KEY
SIEM_COLLECTOR_KEY=CHANGE_ME_COLLECTOR_KEY

# --- explicit administrator bootstrap (created only if no admin exists) -----
SIEM_BOOTSTRAP_ADMIN_USERNAME=admin
SIEM_BOOTSTRAP_ADMIN_PASSWORD=CHANGE_ME_MIN_12_CHARS
SIEM_BOOTSTRAP_ADMIN_EMAIL=admin@example.com

# --- runtime ----------------------------------------------------------------
SIEM_ENV=development
SIEM_HTTP_PORT=8080
GRAFANA_PORT=3000
SIEM_CORS_ORIGINS=http://localhost:8080
SIEM_HOST_NAME=docker-host
OPENSEARCH_JAVA_OPTS=-Xms1g -Xmx1g
SIEM_ALLOW_DEMO_ENDPOINTS=false

# --- production only --------------------------------------------------------
# SIEM_IMAGE_NAMESPACE=your-org/your-repo
# SIEM_VERSION=sha-abc1234
# OPENSEARCH_ADMIN_PASSWORD=CHANGE_ME_STRONG

# --- notifications (optional) -----------------------------------------------
SIEM_SMTP_HOST=
SIEM_SMTP_PORT=25
SIEM_SMTP_USER=
SIEM_SMTP_PASSWORD=
SIEM_SMTP_FROM=siem@example.com
SIEM_SMTP_STARTTLS=false
SIEM_NOTIFY_EMAIL_TO=
SIEM_SLACK_WEBHOOK_URL=

# --- GeoIP (optional; see docs/SECURITY.md for licensing) ---------------------
# SIEM_GEOIP_DB_PATH=/geoip/GeoLite2-City.mmdb
